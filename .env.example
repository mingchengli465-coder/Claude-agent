# Copy this file to .env and fill in the blanks.
#
# 部署到 Railway / Render 時，不要把整份檔案貼進 Variables：
# 貼進去的示範值會被當成真的設定，程式拿到假 token 就起不來。
# 請一個一個變數手動填真正的值。
#
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slug on OpenRouter (optional, this is the default)
MODEL=deepseek/deepseek-chat-v3.1:free

# --- Optional settings ---
# OpenRouter API base URL
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# System prompt handed to the model on every request
# SYSTEM_PROMPT=You are a helpful assistant chatting with a user on Telegram.
# Conversation rounds kept per chat (one round = your message + the reply)
# MAX_HISTORY_ROUNDS=20
# Seconds to wait for an OpenRouter response
# REQUEST_TIMEOUT=60
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# =====================================================================
# X (Twitter) bot powered by Claude — used by x_bot.py only
# =====================================================================

# Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# X app credentials from https://developer.x.com (Projects & Apps → Keys and tokens).
# The app's User authentication settings must be set to "Read and write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Optional Claude settings ---
# CLAUDE_MODEL=claude-opus-5
# Thinking depth / token spend: low, medium, high, xhigh, max
# CLAUDE_EFFORT=low
# CLAUDE_MAX_TOKENS=4096
# Retry a declined request on a fallback model (server-side, Anthropic-routed)
# ENABLE_REFUSAL_FALLBACK=true

# --- Optional bot settings ---
# The account's voice. Separate from the Telegram bot's SYSTEM_PROMPT.
# X_SYSTEM_PROMPT=You are the voice of an X account, replying to people who mention you.
# Seconds between mention checks. Keep this high: reading mentions burns X API quota.
# POLL_INTERVAL_SECONDS=900
# Most mentions answered in a single cycle
# MAX_REPLIES_PER_CYCLE=5
# Ancestor tweets pulled in as context (each level beyond the first costs an API call)
# MAX_THREAD_CONTEXT=4
# 280 for a standard account; X Premium accounts can raise this
# TWEET_CHAR_LIMIT=280
# Tweets a single reply may be split across
# MAX_TWEETS_PER_REPLY=3
# Ask Claude not to include URLs: X charges much more for a post containing a link
# AVOID_LINKS=true
# Comma-separated handles to answer, without @. Empty means everyone.
# ALLOWED_USERS=
# Where since_id and answered-tweet ids are kept between restarts
# STATE_FILE=x_bot_state.json
# Answer mentions that arrived before the bot's first run
# REPLY_TO_BACKLOG=false
# Generate replies and log them without posting anything
# DRY_RUN=false

# --- Scheduled posting (x_bot.py schedule) ---
# File of themes, one per line. The bot rotates through them in order.
# TOPICS_FILE=topics.txt
# Local times to post at each day
# POST_TIMES=09:00
# Timezone those times are in, e.g. Asia/Shanghai, America/New_York
# POST_TIMEZONE=UTC
# How many recent posts Claude sees, so it doesn't repeat itself
# POST_HISTORY_SIZE=12
# Random delay after the scheduled minute, so posting looks less robotic
# POST_JITTER_MINUTES=0

# =====================================================================
# 小红书笔记生成 — used by bot.py (/xhs and the daily job)
# =====================================================================

# Telegram chat id allowed to use /xhs and the note buttons, and where the
# daily note is sent. Leave empty to disable the feature entirely.
# Get it by messaging @userinfobot on Telegram.
ADMIN_CHAT_ID=

# --- Optional ---
# What the notes may say about your service. The model can't add to it, so put
# prices or turnaround here if you want them mentioned. Default: DEFAULT_SERVICE_BRIEF in xhs.py
# XHS_SERVICE_BRIEF=
# The black tag on the cover
# XHS_BADGE_TEXT=接单中
# Daily generation time and the timezone it is read in
# XHS_DAILY_TIME=09:00
# XHS_TIMEZONE=Asia/Taipei
# Model for note generation; falls back to MODEL when unset
# XHS_MODEL=
# The one retry goes to this model instead of XHS_MODEL
# XHS_FALLBACK_MODEL=openrouter/free
# Seconds to wait for a note (generation is longer than a chat reply)
# XHS_REQUEST_TIMEOUT=90
# Token budget. Reasoning models spend part of it thinking, so keep it generous.
# XHS_MAX_TOKENS=8000
# OpenRouter reasoning controls. Lower the effort if content keeps coming back empty.
# XHS_REASONING=true
# XHS_REASONING_EFFORT=low
# XHS_REASONING_EXCLUDE=true
# Where the topic rotation and recent-topic history are kept
# XHS_STATE_FILE=xhs_state.json
# Don't reuse a topic from the last N days
# XHS_AVOID_DAYS=7
# Override the bundled cover font
# XHS_FONT_PATH=fonts/NotoSansSC-VF.ttf
# Ask for response_format=json_object. Turns itself off if the model rejects it.
# XHS_JSON_MODE=true

# =====================================================================
# X 自動發推 — used by bot.py (/tweet, /pause, /resume and the daily jobs)
# =====================================================================
# Publishing reuses the four X_* credentials above. Posting is unattended,
# so they are required for the feature to do anything.

# Model for tweets. Defaults to google/gemma-4-26b-a4b-it:free and does NOT
# fall back to MODEL, so the chat model can't silently take over.
# X_MODEL=
# If X_MODEL fails (e.g. its shared free pool is rate-limited), the one retry
# goes to this model instead. Set it equal to X_MODEL to retry on the same one.
# X_FALLBACK_MODEL=openrouter/free
# Share of tweets written in English; the rest are Simplified Chinese
# X_ENGLISH_RATIO=1.0
# Everything a tweet may say about your design service. The model can't add to it,
# so put prices or turnaround here if you want them mentioned. Default: DEFAULT_SERVICE_BRIEF in tweet.py
# X_SERVICE_BRIEF=
# Your Telegram, replied under every tweet so the tweet itself stays link-free.
# https://t.me/name, @name, just name, or "bot" for this bot itself. Empty = no reply.
# X_TELEGRAM_LINK=
# The reply text; {link} is replaced with the https://t.me/ link
# X_LINK_REPLY_TEXT=Have a website or deck in mind? Message me on Telegram:\n{link}
# Chinese tweets get their own, lower ceiling
# X_TWEET_CHAR_LIMIT_ZH=130
# Daily draft times and their timezone
# X_DAILY_TIMES=12:00,20:00
# A one-off tweet published 10 s after startup, same format as /post (a line of
# just --- splits off a reply). Clear it once it's out; X rejects an exact repeat.
# X_POST_ON_START=
# X_TIMEZONE=Asia/Taipei
# 140 CJK chars is exactly X's 280-weight budget
# X_TWEET_CHAR_LIMIT=140
# X_MAX_TOKENS=8000
# Extra tries on X_FALLBACK_MODEL after X_MODEL fails (openrouter/free draws a new model each time)
# X_FALLBACK_TRIES=2
# Rotation, topic history and the /pause flag. Wiped by a Railway redeploy,
# which resumes posting — the default is "running".
# X_TWEET_STATE_FILE=x_tweet_state.json
# X_AVOID_DAYS=7
# Hashtag cap
# X_MAX_TAGS=2

# =====================================================================
# 客服模式 — used by bot.py (anyone who isn't OWNER_CHAT_ID)
# =====================================================================
# Your own chat id. Your messages and all scheduled jobs are unchanged;
# everyone else gets customer service. Falls back to ADMIN_CHAT_ID.
OWNER_CHAT_ID=
# Customer service answers with Claude. ANTHROPIC_API_KEY is declared in the
# x_bot section above; without it every customer message goes to you instead.
# CS_MODEL=claude-opus-5
# Top up with Alipay at platform.deepseek.com. With it set, the owner's chat,
# 小红书 notes and tweets ask DeepSeek first (OpenRouter free models behind it),
# and customer service uses it when ANTHROPIC_API_KEY is empty.
DEEPSEEK_API_KEY=
# USE_DEEPSEEK=true
# DEEPSEEK_MODEL=deepseek-flash
# CS_DEEPSEEK_MODEL=deepseek-flash
# CS_EFFORT=low
# CS_PRODUCTS_PATH=products.yaml
# Conversation store. A Railway redeploy wipes it unless it's on a Volume.
# CS_DB_PATH=cs.sqlite3
# CS_HISTORY=10
# CS_RATE_LIMIT=5
# CS_TIMEZONE=Asia/Shanghai
