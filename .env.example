# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Model slug on OpenRouter (optional, this is the default)
MODEL=deepseek/deepseek-chat-v3.1:free

# --- Optional settings ---
# OpenRouter API base URL
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# System prompt handed to the model on every request
# SYSTEM_PROMPT=You are a helpful assistant chatting with a user on Telegram.
# Conversation rounds kept per chat (one round = your message + the reply)
# MAX_HISTORY_ROUNDS=20
# Seconds to wait for an OpenRouter response
# REQUEST_TIMEOUT=60
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# =====================================================================
# X (Twitter) bot powered by Claude — used by x_bot.py only
# =====================================================================

# Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# X app credentials from https://developer.x.com (Projects & Apps → Keys and tokens).
# The app's User authentication settings must be set to "Read and write".
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# --- Optional Claude settings ---
# CLAUDE_MODEL=claude-opus-5
# Thinking depth / token spend: low, medium, high, xhigh, max
# CLAUDE_EFFORT=low
# CLAUDE_MAX_TOKENS=4096
# Retry a declined request on a fallback model (server-side, Anthropic-routed)
# ENABLE_REFUSAL_FALLBACK=true

# --- Optional bot settings ---
# The account's voice. Separate from the Telegram bot's SYSTEM_PROMPT.
# X_SYSTEM_PROMPT=You are the voice of an X account, replying to people who mention you.
# Seconds between mention checks. Keep this high: reading mentions burns X API quota.
# POLL_INTERVAL_SECONDS=900
# Most mentions answered in a single cycle
# MAX_REPLIES_PER_CYCLE=5
# Ancestor tweets pulled in as context (each level beyond the first costs an API call)
# MAX_THREAD_CONTEXT=4
# 280 for a standard account; X Premium accounts can raise this
# TWEET_CHAR_LIMIT=280
# Tweets a single reply may be split across
# MAX_TWEETS_PER_REPLY=3
# Ask Claude not to include URLs: X charges much more for a post containing a link
# AVOID_LINKS=true
# Comma-separated handles to answer, without @. Empty means everyone.
# ALLOWED_USERS=
# Where since_id and answered-tweet ids are kept between restarts
# STATE_FILE=x_bot_state.json
# Answer mentions that arrived before the bot's first run
# REPLY_TO_BACKLOG=false
# Generate replies and log them without posting anything
# DRY_RUN=false

# --- Scheduled posting (x_bot.py schedule) ---
# File of themes, one per line. The bot rotates through them in order.
# TOPICS_FILE=topics.txt
# Local times to post at each day
# POST_TIMES=09:00
# Timezone those times are in, e.g. Asia/Shanghai, America/New_York
# POST_TIMEZONE=UTC
# How many recent posts Claude sees, so it doesn't repeat itself
# POST_HISTORY_SIZE=12
# Random delay after the scheduled minute, so posting looks less robotic
# POST_JITTER_MINUTES=0
