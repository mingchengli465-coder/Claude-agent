# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Model slug on OpenRouter (optional, this is the default)
MODEL=deepseek/deepseek-chat-v3.1:free

# --- Optional settings ---
# OpenRouter API base URL
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# System prompt handed to the model on every request
# SYSTEM_PROMPT=You are a helpful assistant chatting with a user on Telegram.
# Conversation rounds kept per chat (one round = your message + the reply)
# MAX_HISTORY_ROUNDS=20
# Seconds to wait for an OpenRouter response
# REQUEST_TIMEOUT=60
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
